<launch>
  <arg name="car_type" value="x4"/>
  <arg name="base_port" default="/dev/abotbase"/>
 
  <arg if="$(eval arg('car_type') == 'x4')" name="low_bat" default="10.3"/>
  
  <!-- 包含底盘驱动（内部已含 rplidar 和 laser_filter） -->
  <include file="$(find abot_driver)/launch/abot_driver.launch">
    <arg name="port" value="$(arg base_port)"/>
  </include>

  <!-- ========== RViz 机器人模型显示 ========== -->
  <param name="robot_description" textfile="$(find abot_model)/urdf/abot_model.urdf" />
  
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <param name="publish_frequency" value="50.0"/>
  </node>
  
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <param name="use_gui" value="false"/>
    <param name="rate" value="50"/>
  </node>

  <!-- 桥接 IMU 命名差异：URDF 里是 base_imu，系统需要 imu_link -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_imu_to_imu_link" 
        args="0 0 0 0 0 0 /base_imu /imu_link"/>
  <!-- ========================================= -->

  <!-- IMU 滤波 -->
  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_filter_madgwick" output="screen" respawn="false">
    <param name="fixed_frame" value="base_link" />
    <param name="use_mag" value="false" />
    <param name="publish_tf" value="false" />
    <param name="use_magnetic_field_msg" value="false" />
    <param name="world_frame" value="enu" />
    <param name="orientation_stddev" value="0.05" />
  </node>

  <!-- EKF 定位（发布 odom → base_footprint 或 base_link） -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization"> 
    <remap from="odometry/filtered" to="odom" />
    <rosparam command="load" file="$(find abot_bringup)/param/ekf/robot_localization.yaml" />
  </node>

  <!-- 激光驱动和过滤器已在 abot_driver.launch 中，这里不再重复 -->

</launch>
